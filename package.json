{
  "name": "everstem",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "test": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply everstem-preview --local",
    "db:seed:local": "tsx scripts/seed-runner.ts --local",
    "db:seed:remote": "tsx scripts/seed-runner.ts --remote",
    "typecheck": "astro check"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@astrojs/cloudflare": "12.3.0",
    "@cloudflare/workers-types": "4.20251011.0",
    "@playwright/test": "1.52.0",
    "astro": "5.15.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.6",
    "typescript": "5.8.3",
    "vitest": "2.1.9",
    "wrangler": "4.2.0"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6"
  }
}
