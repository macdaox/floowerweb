---
interface Props {
  companyName?: string;
  tagline?: string;
  social?: { instagramUrl?: string; pinterestUrl?: string; linkedinUrl?: string };
}

const { companyName = "EVERSTEM", tagline = "Botanical objects for contemporary spaces.", social = {} } = Astro.props;
const navigation = [["Collections", "/collections"], ["Spaces", "/spaces"], ["Journal", "/journal"], ["About", "/about"], ["Wholesale", "/wholesale"], ["Contact", "/contact"]] as const;
---

<footer class="site-footer" id="footer">
  <div class="footer-brand"><a class="footer-wordmark" href="/">{companyName}</a><p>{tagline}</p></div>
  <nav aria-label="Footer navigation">{navigation.map(([label, href]) => <a href={href}>{label}</a>)}</nav>
  <div class="footer-social"><a href={social.instagramUrl ?? "#footer"}>Instagram</a><a href={social.pinterestUrl ?? "#footer"}>Pinterest</a><a href={social.linkedinUrl ?? "#footer"}>LinkedIn</a></div>
  <form class="newsletter" action="/api/subscribers" method="post" aria-labelledby="newsletter-heading" data-newsletter-form data-source-route="/footer"><p class="newsletter-heading" id="newsletter-heading">Notes from EVERSTEM</p><div><label class="visually-hidden" for="newsletter-email">Email address</label><input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="Email address" required /><button type="submit">Subscribe <span aria-hidden="true">→</span></button></div><div class="visually-hidden" aria-hidden="true"><label for="newsletter-website">Website</label><input id="newsletter-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div><p class="form-feedback" role="status" aria-live="polite"></p></form>
  <div class="footer-legal"><span>© {new Date().getFullYear()} EVERSTEM</span><span><a href="/privacy">Privacy</a> <a href="/terms">Terms</a></span></div>
</footer>
