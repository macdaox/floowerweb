---
import PageSections from "../components/public/PageSections.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { getPreviewPageById, getPublishedPage, previewPages } from "../features/content/service";
import { resolvePreviewSecret, verifyPreviewToken } from "../features/admin-content/preview";

const db = Astro.locals.runtime?.env?.DB;
const token = Astro.url.searchParams.get("preview");
const secret = resolvePreviewSecret(Astro.locals.runtime?.env?.SESSION_SECRET);
const claims = db && token && secret ? await verifyPreviewToken(token, secret, "page") : null;
if (claims) Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const content = db ? claims ? await getPreviewPageById(db, claims.id, "about", "en") : await getPublishedPage(db, "about", "en") : previewPages.about;
---

<PublicLayout title={content?.seo.title ?? "About | EVERSTEM"} description={content?.seo.description ?? "About EVERSTEM."} canonical="/about"><PageSections sections={content?.sections ?? []} />{!content && <section class="empty-state section"><p class="eyebrow">About EVERSTEM</p><h1>Our story is being prepared.</h1><p>Please return shortly, or contact us to learn more about the studio.</p><a class="button button-primary" href="/contact">Contact EVERSTEM</a></section>}</PublicLayout>
