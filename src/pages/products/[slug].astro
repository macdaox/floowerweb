---
import ProductCard from "../../components/public/ProductCard.astro";
import ResponsiveImage from "../../components/public/ResponsiveImage.astro";
import { selectGalleryImage } from "../../components/public/ProductGallery";
import { productInquiryFields } from "../../components/public/ProductInquiryForm";
import { breadcrumbData, productData } from "../../components/public/structured-data";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { getPreviewProductById, getPublishedProductBySlug, previewProduct } from "../../features/catalog/service";
import { resolvePreviewSecret, verifyPreviewToken } from "../../features/admin-content/preview";
import { resolvePublicSiteOrigin } from "../../features/public/site-origin";

const slug = Astro.params.slug ?? "";
const db = Astro.locals.runtime?.env?.DB;
const publicOrigin = resolvePublicSiteOrigin(Astro.locals.runtime?.env?.PUBLIC_SITE_URL);
const token = Astro.url.searchParams.get("preview");
const previewSecret = resolvePreviewSecret(Astro.locals.runtime?.env?.SESSION_SECRET);
const claims = db && token && previewSecret ? await verifyPreviewToken(token, previewSecret, "product") : null;
if (claims) Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const product = db
  ? claims ? await getPreviewProductById(db, "en", claims.id, slug) : await getPublishedProductBySlug(db, "en", slug)
  : previewProduct(slug);
if (!product) Astro.response.status = 404;
const selectedImage = product ? selectGalleryImage(product.images, 0) : undefined;
const galleryImages = product && selectedImage ? [selectedImage, ...product.images.filter((image) => image.src !== selectedImage.src)] : [];
const inquiry = product ? productInquiryFields(product.id, product.name, Astro.url.pathname) : null;
const structuredData = product ? [
  productData(publicOrigin, product),
  breadcrumbData(publicOrigin, [
    { name: "Home", path: "/" },
    { name: "Collections", path: "/collections" },
    { name: product.category.name, path: `/collections/${product.category.slug}` },
    { name: product.name, path: `/products/${product.slug}` },
  ]),
] : [];
---

<PublicLayout title={product?.seo.title ?? "Product not found | EVERSTEM"} description={product?.seo.description ?? "The requested EVERSTEM product is unavailable."} socialImage={product?.images[0]?.src} socialImageAlt={product?.images[0]?.alt} canonical={`/products/${slug}`} ogType={product ? "product" : "website"} noindex={!product || Boolean(claims)} structuredData={structuredData}>
  {product && inquiry ?
  <article>
    <section class="product-detail section">
      <div class="product-gallery" aria-label={`${product.name} gallery`} data-product-gallery>
        {galleryImages.length ? <>{galleryImages.map((image, index) => <figure id={`image-${index}`} data-gallery-item aria-label={`Image ${index + 1} of ${galleryImages.length}`} tabindex={index === 0 ? "0" : "-1"}><ResponsiveImage image={image} fallbackWidth={1400} fallbackHeight={1750} widths={[480, 800, 1400]} sizes="(max-width: 800px) 100vw, 58vw" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : undefined} /><figcaption class="visually-hidden">Image {index + 1} of {galleryImages.length}</figcaption></figure>)}</> : <div class="gallery-empty">Product imagery will be available shortly.</div>}
      </div>
      <div class="product-copy">
        <p class="eyebrow"><a href={`/collections/${product.category.slug}`}>{product.category.name}</a></p>
        <h1>{product.name}</h1>
        <p class="product-summary">{product.summary}</p>
        {product.body && <p>{product.body}</p>}
        <dl class="product-specifications"><dt><h2>Specifications</h2></dt>{product.specifications.map((specification) => <div><dt>{specification.label}</dt><dd>{specification.value}</dd></div>)}</dl>
        <form class="product-inquiry-form" action="/api/inquiries" method="post" aria-label={`Inquire about ${product.name}`} data-inquiry-form data-inquiry-type="product" data-source-route={inquiry.sourceRoute}>
          <input type="hidden" name="inquiry_type" value="product" />
          <input type="hidden" name="product_id" value={inquiry.productId} />
          <input type="hidden" name="product_name" value={inquiry.productName} />
          <input type="hidden" name="source_route" value={inquiry.sourceRoute} />
          <h2>Request product information</h2>
          <label for="inquiry-name">Name<input id="inquiry-name" name="name" autocomplete="name" required minlength="2" maxlength="120" aria-describedby="inquiry-name-error" /></label><p class="form-error" id="inquiry-name-error" data-field-error="name" role="alert"></p>
          <label for="inquiry-email">Business email<input id="inquiry-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="inquiry-email-error" /></label><p class="form-error" id="inquiry-email-error" data-field-error="email" role="alert"></p>
          <label for="inquiry-message">What are you sourcing?<textarea id="inquiry-message" name="message" rows="3" maxlength="2000" aria-describedby="inquiry-message-error"></textarea></label><p class="form-error" id="inquiry-message-error" data-field-error="message" role="alert"></p><p class="form-error" data-field-error="product_id" role="alert"></p>
          <div class="visually-hidden" aria-hidden="true"><label for="inquiry-website">Website</label><input id="inquiry-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
          <button class="button button-primary" type="submit">Send inquiry</button><p class="form-feedback" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
    {product.relatedProducts.length > 0 && <section class="catalog-section section" aria-labelledby="related-products"><header class="catalog-section-heading"><p class="eyebrow">More from {product.category.name}</p><h2 id="related-products">Related products</h2></header><div class="product-grid">{product.relatedProducts.map((item) => <ProductCard product={item} />)}</div></section>}
  </article> : <section class="empty-state section"><p class="eyebrow">Not found</p><h1>This product has moved on.</h1><p>The product you requested is unavailable. Browse our current botanical collections instead.</p><a class="button button-primary" href="/collections">View collections</a></section>}
</PublicLayout>

<script>
  import { initializeProductGalleries } from "../../components/public/ProductGallery";
  initializeProductGalleries();
  document.addEventListener("astro:page-load", initializeProductGalleries);
</script>
