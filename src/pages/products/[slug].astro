---
import ProductCard from "../../components/public/ProductCard.astro";
import { selectGalleryImage } from "../../components/public/ProductGallery";
import { productInquiryFields } from "../../components/public/ProductInquiryForm";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { getPublishedProductBySlug, previewProduct } from "../../features/catalog/service";

const slug = Astro.params.slug ?? "";
const db = Astro.locals.runtime?.env?.DB;
const product = db ? await getPublishedProductBySlug(db, "en", slug) : previewProduct(slug);
if (!product) return new Response("Not found", { status: 404 });
const selectedImage = selectGalleryImage(product.images, 0);
const galleryImages = selectedImage ? [selectedImage, ...product.images.filter((image) => image.src !== selectedImage.src)] : [];
const inquiry = productInquiryFields(product.id, product.name, Astro.url.pathname);
---

<PublicLayout title={product.seo.title} description={product.seo.description} socialImage={product.images[0]?.src}>
  <article>
    <section class="product-detail section">
      <div class="product-gallery" aria-label={`${product.name} gallery`}>
        {galleryImages.length ? <>{galleryImages.map((image, index) => <figure id={`image-${index}`}><img src={image.src} alt={image.alt} width="1400" height="1750" loading={index === 0 ? "eager" : "lazy"} /><figcaption class="visually-hidden">Image {index + 1} of {galleryImages.length}</figcaption></figure>)}</> : <div class="gallery-empty">Product imagery will be available shortly.</div>}
      </div>
      <div class="product-copy">
        <p class="eyebrow"><a href={`/collections/${product.category.slug}`}>{product.category.name}</a></p>
        <h1>{product.name}</h1>
        <p class="product-summary">{product.summary}</p>
        {product.body && <p>{product.body}</p>}
        <dl class="product-specifications"><dt><h2>Specifications</h2></dt>{product.specifications.map((specification) => <div><dt>{specification.label}</dt><dd>{specification.value}</dd></div>)}</dl>
        <form class="product-inquiry-form" action="/api/inquiries" method="post" aria-label={`Inquire about ${product.name}`} data-inquiry-form data-inquiry-type="product" data-source-route={inquiry.sourceRoute}>
          <input type="hidden" name="inquiry_type" value="product" />
          <input type="hidden" name="product_id" value={inquiry.productId} />
          <input type="hidden" name="product_name" value={inquiry.productName} />
          <input type="hidden" name="source_route" value={inquiry.sourceRoute} />
          <h2>Request product information</h2>
          <label for="inquiry-name">Name<input id="inquiry-name" name="name" autocomplete="name" required maxlength="120" aria-describedby="inquiry-name-error" /></label><p class="form-error" id="inquiry-name-error" data-field-error="name" role="alert"></p>
          <label for="inquiry-email">Business email<input id="inquiry-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="inquiry-email-error" /></label><p class="form-error" id="inquiry-email-error" data-field-error="email" role="alert"></p>
          <label for="inquiry-message">What are you sourcing?<textarea id="inquiry-message" name="message" rows="3" maxlength="2000" aria-describedby="inquiry-message-error"></textarea></label><p class="form-error" id="inquiry-message-error" data-field-error="message" role="alert"></p><p class="form-error" data-field-error="product_id" role="alert"></p>
          <div class="visually-hidden" aria-hidden="true"><label for="inquiry-website">Website</label><input id="inquiry-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
          <button class="button button-primary" type="submit">Send inquiry</button><p class="form-feedback" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>
    {product.relatedProducts.length > 0 && <section class="catalog-section section" aria-labelledby="related-products"><header class="catalog-section-heading"><p class="eyebrow">More from {product.category.name}</p><h2 id="related-products">Related products</h2></header><div class="product-grid">{product.relatedProducts.map((item) => <ProductCard product={item} />)}</div></section>}
  </article>
</PublicLayout>
