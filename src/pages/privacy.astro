---
import PageSections from "../components/public/PageSections.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { getPreviewPageById, getPublishedPage, previewPages } from "../features/content/service";
import { resolvePreviewSecret, verifyPreviewToken } from "../features/admin-content/preview";

const db = Astro.locals.runtime?.env?.DB;
const token = Astro.url.searchParams.get("preview");
const secret = resolvePreviewSecret(Astro.locals.runtime?.env?.SESSION_SECRET);
const claims = db && token && secret ? await verifyPreviewToken(token, secret, "page") : null;
if (claims) Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const content = db ? claims ? await getPreviewPageById(db, claims.id, "privacy", "en") : await getPublishedPage(db, "privacy", "en") : previewPages.privacy;
---

<PublicLayout title={content?.seo.title ?? "Privacy | EVERSTEM"} description={content?.seo.description ?? "EVERSTEM privacy policy."} canonical="/privacy" noindex={Boolean(claims)}><PageSections sections={content?.sections ?? []} />{!content && <section class="empty-state section"><p class="eyebrow">Privacy</p><h1>Our privacy notice is being prepared.</h1><p>Please contact us with any questions about your information.</p></section>}</PublicLayout>
