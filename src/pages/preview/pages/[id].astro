---
import PageSections from "../../../components/public/PageSections.astro";
import PublicLayout from "../../../layouts/PublicLayout.astro";
import { resolvePreviewSecret, verifyPreviewToken } from "../../../features/admin-content/preview";
import { getPreviewPage } from "../../../features/content/service";

const id = Astro.params.id ?? "";
const token = Astro.url.searchParams.get("preview") ?? "";
const db = Astro.locals.runtime?.env?.DB;
const secret = resolvePreviewSecret(Astro.locals.runtime?.env?.SESSION_SECRET);
const claims = db && secret ? await verifyPreviewToken(token, secret, "page", id) : null;
const content = db && claims ? await getPreviewPage(db, id, "en") : null;
if (!content) return new Response("Not found", { status: 404 });
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
---

<PublicLayout title={`${content.seo.title} · Preview`} description={content.seo.description} canonical={`/preview/pages/${id}`}>
  <aside class="preview-notice" aria-label="Draft preview">Draft preview</aside>
  <PageSections sections={content.sections} />
</PublicLayout>
