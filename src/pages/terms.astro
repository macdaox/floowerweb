---
import PageSections from "../components/public/PageSections.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { getPublishedPage, previewPages } from "../features/content/service";

const db = Astro.locals.runtime?.env?.DB;
const content = db ? await getPublishedPage(db, "terms", "en") : previewPages.terms;
---

<PublicLayout title={content?.seo.title ?? "Terms | EVERSTEM"} description={content?.seo.description ?? "EVERSTEM terms."}><PageSections sections={content?.sections ?? []} />{!content && <section class="empty-state section"><p class="eyebrow">Terms</p><h1>Our terms are being prepared.</h1><p>Please contact us with any questions about using this site.</p></section>}</PublicLayout>
