---
import PageSections from "../components/public/PageSections.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { getPublishedPage, previewPages } from "../features/content/service";

const db = Astro.locals.runtime?.env?.DB;
const content = db ? await getPublishedPage(db, "contact", "en") ?? previewPages.contact : previewPages.contact;
---

<PublicLayout title={content?.seo.title ?? "Contact | EVERSTEM"} description={content?.seo.description ?? "Contact EVERSTEM."}><PageSections sections={content?.sections ?? []} />{content ? <section class="form-section section"><header><p class="eyebrow">Enquiries</p><h2>Tell us what you are planning.</h2></header><form class="catalog-form" action="/api/inquiries" method="post" aria-label="Contact EVERSTEM" data-inquiry-form data-inquiry-type="contact" data-source-route="/contact"><div class="form-field"><label for="contact-name">Name</label><input id="contact-name" name="name" autocomplete="name" required aria-describedby="contact-name-error" /><p class="form-error" id="contact-name-error" data-field-error="name"></p></div><div class="form-field"><label for="contact-company">Company</label><input id="contact-company" name="company" autocomplete="organization" /></div><div class="form-field"><label for="contact-email">Business email</label><input id="contact-email" name="email" type="email" autocomplete="email" required aria-describedby="contact-email-error" /><p class="form-error" id="contact-email-error" data-field-error="email"></p></div><div class="form-field"><label for="contact-phone">Phone</label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" /></div><div class="form-field form-field-wide"><label for="contact-message">How can we help?</label><textarea id="contact-message" name="message" rows="4"></textarea></div><div class="visually-hidden" aria-hidden="true"><label for="contact-website">Website</label><input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div><div class="form-submit"><button class="button button-primary" type="submit">Send enquiry</button><p class="form-feedback" role="status" aria-live="polite"></p></div></form></section> : <section class="empty-state section"><p class="eyebrow">Contact</p><h1>Our contact page is being prepared.</h1><p>Please return shortly.</p></section>}</PublicLayout>
