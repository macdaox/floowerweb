---
import PageSections from "../components/public/PageSections.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { getPublishedPage, previewPages } from "../features/content/service";

const db = Astro.locals.runtime?.env?.DB;
const content = db ? await getPublishedPage(db, "contact", "en") : previewPages.contact;
---

<PublicLayout title={content?.seo.title ?? "Contact | EVERSTEM"} description={content?.seo.description ?? "Contact EVERSTEM."}><PageSections sections={content?.sections ?? []} />{content ? <section class="form-section section"><header><p class="eyebrow">Enquiries</p><h2>Tell us what you are planning.</h2></header><form class="catalog-form" aria-label="Contact EVERSTEM"><div class="form-field"><label for="contact-name">Name</label><input id="contact-name" name="name" autocomplete="name" required /></div><div class="form-field"><label for="contact-company">Company</label><input id="contact-company" name="company" autocomplete="organization" /></div><div class="form-field"><label for="contact-email">Business email</label><input id="contact-email" name="email" type="email" autocomplete="email" required /></div><div class="form-field"><label for="contact-phone">Phone</label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" /></div><div class="form-field form-field-wide"><label for="contact-message">How can we help?</label><textarea id="contact-message" name="message" rows="4"></textarea></div><div class="form-submit"><button class="button button-primary" type="button">Send enquiry</button></div></form></section> : <section class="empty-state section"><p class="eyebrow">Contact</p><h1>Our contact page is being prepared.</h1><p>Please return shortly.</p></section>}</PublicLayout>
