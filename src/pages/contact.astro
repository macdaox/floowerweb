---
import PageSections from "../components/public/PageSections.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { getPreviewPageById, getPublishedPage, previewPages } from "../features/content/service";
import { resolvePreviewSecret, verifyPreviewToken } from "../features/admin-content/preview";

const db = Astro.locals.runtime?.env?.DB;
const token = Astro.url.searchParams.get("preview");
const secret = resolvePreviewSecret(Astro.locals.runtime?.env?.SESSION_SECRET);
const claims = db && token && secret ? await verifyPreviewToken(token, secret, "page") : null;
if (claims) Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const content = db ? claims ? await getPreviewPageById(db, claims.id, "contact", "en") : await getPublishedPage(db, "contact", "en") ?? previewPages.contact : previewPages.contact;
---

<PublicLayout title={content?.seo.title ?? "Contact | EVERSTEM"} description={content?.seo.description ?? "Contact EVERSTEM."} canonical="/contact">
  <PageSections sections={content?.sections ?? []} />
  {content ? <section class="form-section section"><header><p class="eyebrow">Enquiries</p><h2>Tell us what you are planning.</h2></header>
    <form class="catalog-form" action="/api/inquiries" method="post" aria-label="Contact EVERSTEM" data-inquiry-form data-inquiry-type="contact" data-source-route="/contact">
      <input type="hidden" name="inquiry_type" value="contact" /><input type="hidden" name="source_route" value="/contact" />
      <div class="form-field"><label for="contact-name">Name</label><input id="contact-name" name="name" autocomplete="name" required minlength="2" maxlength="120" aria-describedby="contact-name-error" /><p class="form-error" id="contact-name-error" data-field-error="name" role="alert"></p></div>
      <div class="form-field"><label for="contact-company">Company</label><input id="contact-company" name="company" autocomplete="organization" maxlength="120" aria-describedby="contact-company-error" /><p class="form-error" id="contact-company-error" data-field-error="company" role="alert"></p></div>
      <div class="form-field"><label for="contact-email">Business email</label><input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="contact-email-error" /><p class="form-error" id="contact-email-error" data-field-error="email" role="alert"></p></div>
      <div class="form-field"><label for="contact-phone">Phone</label><input id="contact-phone" name="phone" type="tel" autocomplete="tel" maxlength="60" aria-describedby="contact-phone-error" /><p class="form-error" id="contact-phone-error" data-field-error="phone" role="alert"></p></div>
      <div class="form-field form-field-wide"><label for="contact-message">How can we help?</label><textarea id="contact-message" name="message" rows="4" maxlength="2000" aria-describedby="contact-message-error"></textarea><p class="form-error" id="contact-message-error" data-field-error="message" role="alert"></p></div>
      <div class="visually-hidden" aria-hidden="true"><label for="contact-website">Website</label><input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
      <div class="form-submit"><button class="button button-primary" type="submit">Send enquiry</button><p class="form-feedback" role="status" aria-live="polite"></p></div>
    </form>
  </section> : <section class="empty-state section"><p class="eyebrow">Contact</p><h1>Our contact page is being prepared.</h1><p>Please return shortly.</p></section>}
</PublicLayout>
