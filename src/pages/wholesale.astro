---
import PageSections from "../components/public/PageSections.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { getPublishedPage, previewPages } from "../features/content/service";
const db = Astro.locals.runtime?.env?.DB;
const content = db ? await getPublishedPage(db, "wholesale", "en") ?? previewPages.wholesale : previewPages.wholesale;
---

<PublicLayout title={content?.seo.title ?? "Wholesale | EVERSTEM"} description={content?.seo.description ?? "Wholesale with EVERSTEM."}>
  <PageSections sections={content?.sections ?? []} />
  {content ? <section class="form-section section" id="catalog-form"><header><p class="eyebrow">Request catalog</p><h2>Let’s find the right botanical range.</h2></header>
    <form class="catalog-form" action="/api/inquiries" method="post" aria-label="Request wholesale catalog" data-inquiry-form data-inquiry-type="catalog" data-source-route="/wholesale">
      <input type="hidden" name="inquiry_type" value="catalog" /><input type="hidden" name="source_route" value="/wholesale" />
      <div class="form-field"><label for="wholesale-name">Name</label><input id="wholesale-name" name="name" autocomplete="name" required maxlength="120" aria-describedby="wholesale-name-error" /><p class="form-error" id="wholesale-name-error" data-field-error="name" role="alert"></p></div>
      <div class="form-field"><label for="wholesale-company">Company</label><input id="wholesale-company" name="company" autocomplete="organization" required maxlength="120" aria-describedby="wholesale-company-error" /><p class="form-error" id="wholesale-company-error" data-field-error="company" role="alert"></p></div>
      <div class="form-field"><label for="wholesale-email">Business email</label><input id="wholesale-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="wholesale-email-error" /><p class="form-error" id="wholesale-email-error" data-field-error="email" role="alert"></p></div>
      <div class="form-field"><label for="wholesale-country">Country / market</label><input id="wholesale-country" name="country" autocomplete="country-name" required maxlength="120" aria-describedby="wholesale-country-error" /><p class="form-error" id="wholesale-country-error" data-field-error="country" role="alert"></p></div>
      <div class="form-field"><label for="wholesale-buyer">Buyer type</label><select id="wholesale-buyer" name="buyer_type" required aria-describedby="wholesale-buyer-error"><option value="" selected disabled>Select</option><option>Retailer</option><option>Importer</option><option>Distributor</option><option>Design professional</option><option>Commercial project buyer</option></select><p class="form-error" id="wholesale-buyer-error" data-field-error="buyer_type" role="alert"></p></div>
      <div class="form-field"><label for="wholesale-interest">Product interest</label><input id="wholesale-interest" name="product_interest" required maxlength="120" aria-describedby="wholesale-interest-error" /><p class="form-error" id="wholesale-interest-error" data-field-error="interests" role="alert"></p></div>
      <div class="form-field form-field-wide"><label for="wholesale-message">What are you sourcing?</label><textarea id="wholesale-message" name="message" rows="4" maxlength="2000" aria-describedby="wholesale-message-error"></textarea><p class="form-error" id="wholesale-message-error" data-field-error="message" role="alert"></p></div>
      <div class="visually-hidden" aria-hidden="true"><label for="wholesale-website">Website</label><input id="wholesale-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
      <div class="form-submit"><button class="button button-primary" type="submit">Request catalog</button><p class="form-feedback" role="status" aria-live="polite"></p></div>
    </form>
  </section> : <section class="empty-state section"><p class="eyebrow">Wholesale</p><h1>Our trade information is being prepared.</h1><p>Please return shortly.</p></section>}
</PublicLayout>
