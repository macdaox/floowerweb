---
import PageSections from "../components/public/PageSections.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { getPublishedPage, previewPages } from "../features/content/service";

const db = Astro.locals.runtime?.env?.DB;
const content = db ? await getPublishedPage(db, "wholesale", "en") : previewPages.wholesale;
---

<PublicLayout title={content?.seo.title ?? "Wholesale | EVERSTEM"} description={content?.seo.description ?? "Wholesale with EVERSTEM."}><PageSections sections={content?.sections ?? []} />{content ? <section class="form-section section" id="catalog-form"><header><p class="eyebrow">Request catalog</p><h2>Let’s find the right botanical range.</h2></header><form class="catalog-form" aria-label="Request wholesale catalog"><div class="form-field"><label for="wholesale-name">Name</label><input id="wholesale-name" name="name" autocomplete="name" required /></div><div class="form-field"><label for="wholesale-company">Company</label><input id="wholesale-company" name="company" autocomplete="organization" required /></div><div class="form-field"><label for="wholesale-email">Business email</label><input id="wholesale-email" name="email" type="email" autocomplete="email" required /></div><div class="form-field"><label for="wholesale-country">Country / market</label><input id="wholesale-country" name="country" autocomplete="country-name" required /></div><div class="form-field form-field-wide"><label for="wholesale-message">What are you sourcing?</label><textarea id="wholesale-message" name="message" rows="4"></textarea></div><div class="form-submit"><button class="button button-primary" type="button">Request catalog</button></div></form></section> : <section class="empty-state section"><p class="eyebrow">Wholesale</p><h1>Our trade information is being prepared.</h1><p>Please return shortly.</p></section>}</PublicLayout>
