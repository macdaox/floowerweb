---
import ProductCard from "../../components/public/ProductCard.astro";
import NotFoundState from "../../components/public/NotFoundState.astro";
import { breadcrumbData } from "../../components/public/structured-data";
import PublicLayout from "../../layouts/PublicLayout.astro";
import { getPreviewCategoryById, getPublishedCategoryBySlug, listPublishedCategories, listPublishedProducts, previewCatalog } from "../../features/catalog/service";
import { resolvePreviewSecret, verifyPreviewToken } from "../../features/admin-content/preview";
import { resolvePublicSiteOrigin } from "../../features/public/site-origin";

const slug = Astro.params.category ?? "";
const db = Astro.locals.runtime?.env?.DB;
const publicOrigin = resolvePublicSiteOrigin(Astro.locals.runtime?.env?.PUBLIC_SITE_URL);
const requestedPage = Number.parseInt(Astro.url.searchParams.get("page") ?? "1", 10);
const page = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;
const previewCategory = previewCatalog.categories.find((candidate) => candidate.slug === slug) ?? null;
const token = Astro.url.searchParams.get("preview");
const secret = resolvePreviewSecret(Astro.locals.runtime?.env?.SESSION_SECRET);
const claims = db && token && secret ? await verifyPreviewToken(token, secret, "category") : null;
if (claims) Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
const [category, categories, products] = db
  ? await Promise.all([claims ? getPreviewCategoryById(db, "en", claims.id, slug) : getPublishedCategoryBySlug(db, "en", slug), listPublishedCategories(db, "en"), listPublishedProducts(db, { locale: "en", categorySlug: slug, page })])
  : [previewCategory, previewCatalog.categories, { items: previewCatalog.products.filter((product) => product.category.slug === slug), page: 1, pageSize: 24 as const, total: previewCatalog.products.filter((product) => product.category.slug === slug).length, totalPages: 1 }];
const outOfRange = Boolean(category) && page > products.totalPages;
if (!category || outOfRange) Astro.response.status = 404;
const title = outOfRange ? "Page not found | EVERSTEM" : category ? `${category.name}${page > 1 ? ` — Page ${page}` : ""} | EVERSTEM` : "Collection not found | EVERSTEM";
const description = outOfRange ? "The requested EVERSTEM page could not be found." : category ? `${category.description}${page > 1 ? ` Page ${page}.` : ""}` : "The requested EVERSTEM collection is unavailable.";
const canonical = page > 1 ? `/collections/${slug}?page=${page}` : `/collections/${slug}`;
---

<PublicLayout title={title} description={description} socialImage={category?.image?.src} socialImageAlt={category?.image?.alt} canonical={canonical} noindex={!category || outOfRange || Boolean(claims)} structuredData={category && !outOfRange ? [breadcrumbData(publicOrigin, [{ name: "Home", path: "/" }, { name: "Collections", path: "/collections" }, { name: category.name, path: canonical }])] : []}>
  {outOfRange ? <NotFoundState /> : category ? <>
  <section class="catalog-hero section">
    <p class="eyebrow">Collection</p>
    <h1>{category.name}</h1>
    <p>{category.description}</p>
  </section>
  <section class="catalog-section section" aria-label="Collection categories">
    <nav class="catalog-filter"><a href="/collections">All collections</a>{categories.map((item) => <a aria-current={item.slug === category.slug ? "page" : undefined} href={`/collections/${item.slug}`}>{item.name}</a>)}</nav>
  </section>
  <section class="catalog-section section" aria-labelledby="category-products">
    <header class="catalog-section-heading"><p class="eyebrow">{category.name}</p><h2 id="category-products">Objects for considered spaces.</h2></header>
    {products.items.length ? <div class="product-grid">{products.items.map((product) => <ProductCard product={product} />)}</div> : <p class="catalog-empty">No published products are available in this collection yet.</p>}
    {products.totalPages > 1 && <nav class="pagination" aria-label="Product pages">{products.page > 1 && <a href={`/collections/${category.slug}?page=${products.page - 1}`}>Previous</a>}<span>Page {products.page} of {products.totalPages}</span>{products.page < products.totalPages && <a href={`/collections/${category.slug}?page=${products.page + 1}`}>Next</a>}</nav>}
  </section>
  </> : <section class="empty-state section"><p class="eyebrow">Not found</p><h1>This collection has moved on.</h1><p>The collection you requested is unavailable. Browse our current botanical collections instead.</p><a class="button button-primary" href="/collections">View collections</a></section>}
</PublicLayout>
