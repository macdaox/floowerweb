---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireRole } from "../../features/auth/authorize";
const user = requireRole(Astro.locals, ["admin", "editor", "sales"]);
if (user.role === "editor") return Astro.redirect("/admin");
---
<AdminLayout title="订阅者" user={user}>
  <section class="dashboard content-admin-page" aria-labelledby="subscribers-title">
    <header class="dashboard__heading"><div><p class="admin-kicker">营销名单</p><h1 id="subscribers-title">订阅者</h1></div></header>
    <p class="dashboard-panel__copy">筛选订阅状态与来源，并导出安全的 CSV 文件。</p>
    <div data-subscriber-list></div>
  </section>
  <script>import { initializeSubscriberList } from "../../components/admin/SubscriberList"; const root = document.querySelector<HTMLElement>("[data-subscriber-list]"); if (root) initializeSubscriberList(root);</script>
</AdminLayout>
