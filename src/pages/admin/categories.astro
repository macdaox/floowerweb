---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireRole } from "../../features/auth/authorize";
const user = requireRole(Astro.locals, ["admin", "editor"]);
---
<AdminLayout title="分类" user={user}><section class="dashboard content-admin-page" aria-labelledby="content-title"><header class="dashboard__heading"><div><p class="admin-kicker">内容工作台</p><h1 id="content-title">分类</h1></div><a class="admin-secondary-button" href="/admin/products">返回产品</a></header><p class="dashboard-panel__copy">管理分类，支持草稿、预览、发布和归档。</p><div data-content-list data-content-entity="categories"></div></section><script>import { initializeContentList } from "../../components/admin/ContentList"; const root = document.querySelector<HTMLElement>("[data-content-list]"); if (root) initializeContentList(root);</script></AdminLayout>
