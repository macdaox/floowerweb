---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireRole } from "../../features/auth/authorize";
const user = requireRole(Astro.locals, ["admin", "editor"]);
---
<AdminLayout title="期刊内容" user={user}><section class="dashboard content-admin-page" aria-labelledby="content-title"><header class="dashboard__heading"><div><p class="admin-kicker">内容工作台</p><h1 id="content-title">期刊内容</h1></div></header><p class="dashboard-panel__copy">管理期刊文章，支持草稿、预览、发布和归档。</p><div data-content-list data-content-entity="articles"></div></section><script>import { initializeContentList } from "../../components/admin/ContentList"; const root = document.querySelector<HTMLElement>("[data-content-list]"); if (root) initializeContentList(root);</script></AdminLayout>
