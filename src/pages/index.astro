---
import Reveal from "../components/public/Reveal.astro";
import PageSections from "../components/public/PageSections.astro";
import ResponsiveImage from "../components/public/ResponsiveImage.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { loadHomeContent } from "../features/public/home";

const content = await loadHomeContent(Astro.locals.runtime?.env?.DB);
const [heroFirst, heroSecond = ""] = (content.hero?.title ?? "").split(",");
const collectionDescriptions = ["Single stems & arrangements", "Flowering & foliage branches", "Potted botanical forms", "Floor-standing statement trees", "Custom commercial displays"];
---

<PublicLayout title={content.seo.title} description={content.seo.description} canonical="/" socialImage={content.hero?.image?.src} socialImageAlt={content.hero?.image?.alt} theme="transparent">
  {content.hero && <section class="hero" id="hero">
    <div class="hero-copy" data-reveal><p class="eyebrow">{content.hero.eyebrow}</p><h1>{heroFirst},<br />{heroSecond.trim()}</h1><p class="hero-intro">Wholesale artificial flowers, plants and trees for retailers, importers and distributors worldwide.</p><div class="actions"><a class="button button-primary" href="/wholesale#catalog-form">Request catalog</a><a class="button button-secondary" href="/collections">Explore wholesale collections</a></div></div>
    {content.hero.image && <figure class="hero-visual"><ResponsiveImage image={content.hero.image} fallbackWidth={1536} fallbackHeight={1024} widths={[640, 1024, 1536]} sizes="(max-width: 639px) 100vw, 58vw" loading="eager" fetchpriority="high" /></figure>}
    <span class="wholesale-mark">Trade & Wholesale</span>
  </section>}

  <PageSections sections={content.sections} reveal prioritizeLeadingImage={false} />

  <section class="collections section" id="collections"><header class="section-heading" data-reveal><div><p class="eyebrow">Our collections</p><h2>Botanical<br />forms.</h2></div><p>Objects with a natural rhythm, composed for spaces that value permanence over seasonality.</p></header><div class="collection-grid">{content.categories.slice(0, 5).map((category, index) => <a class:list={["collection-card", index === 0 && "collection-card-tall", index === 1 && "collection-card-wide", index === 4 && "collection-card-installation"]} href={`/collections/${category.slug}`} data-reveal>{category.image && <ResponsiveImage image={category.image} fallbackWidth={1200} fallbackHeight={1400} widths={[320, 640, 1200]} sizes="(max-width: 639px) 50vw, (max-width: 1023px) 50vw, 33vw" loading="lazy" />}<span><b>{category.name}</b><i>{collectionDescriptions[index] ?? category.description}</i></span></a>)}</div><a class="text-link" href="/wholesale#catalog-form">Request catalog</a></section>

  {content.space && <section class="spaces section" id="spaces"><header class="section-heading light" data-reveal><div><h2>Botanicals,<br />in context.</h2></div><p>Custom botanical installations developed for commercial interiors and branded environments.</p></header><div class="spaces-tabs" aria-label="Space categories"><span class="active">Hospitality</span><span>Retail</span><span>Workplace</span><span>Events</span><span>Public spaces</span></div><a href={`/spaces/${content.space.slug}`}>{content.space.image && <figure class="spaces-visual" data-reveal><ResponsiveImage image={content.space.image} fallbackWidth={1600} fallbackHeight={1067} widths={[640, 1024, 1600]} sizes="(max-width: 639px) 190vw, 100vw" loading="lazy" /><figcaption><span>{content.space.category}</span><span>{content.space.summary}</span></figcaption></figure>}</a></section>}

  <section class="journal section" id="journal"><header class="section-heading" data-reveal><div><p class="eyebrow">Botanical stories</p><h2>Notes on nature,<br />material & form.</h2></div><a class="text-link" href="/journal">View journal <span aria-hidden="true">→</span></a></header><div class="journal-grid">{content.articles.map((article, index) => <article class:list={["story", index === 0 && "story-featured"]} data-reveal><a href={`/journal/${article.slug}`}>{article.image && <ResponsiveImage image={article.image} fallbackWidth={1000} fallbackHeight={1250} widths={[480, 800, 1000]} sizes="(max-width: 639px) 100vw, 50vw" loading="lazy" />}<p class="meta">{article.category} · {article.readTime}</p><h3>{article.title}</h3></a></article>)}</div></section>

  <section class="trade section" id="trade"><div class="trade-copy" data-reveal><p class="eyebrow">For trade</p><h2>Partner with<br />EVERSTEM.</h2><p>Source artificial flowers and botanicals for wholesale collections, private label and commercial projects.</p><div class="trade-services"><span>Wholesale collections</span><span>Private label</span><span>Sampling & development</span><span>Export & project supply</span></div><form class="catalog-form" id="catalog-form" action="/api/inquiries" method="post" aria-label="Partner with EVERSTEM" data-inquiry-form data-inquiry-type="catalog" data-source-route="/"><div class="form-field"><label for="catalog-name">Name</label><input id="catalog-name" name="name" type="text" autocomplete="name" required minlength="2" maxlength="120" aria-describedby="catalog-name-error" /><p class="form-error" id="catalog-name-error" data-field-error="name" role="alert"></p></div><div class="form-field"><label for="catalog-company">Company</label><input id="catalog-company" name="company" type="text" autocomplete="organization" required maxlength="120" aria-describedby="catalog-company-error" /><p class="form-error" id="catalog-company-error" data-field-error="company" role="alert"></p></div><div class="form-field"><label for="catalog-email">Business email</label><input id="catalog-email" name="email" type="email" autocomplete="email" required maxlength="254" aria-describedby="catalog-email-error" /><p class="form-error" id="catalog-email-error" data-field-error="email" role="alert"></p></div><div class="form-field"><label for="catalog-country">Country / market</label><input id="catalog-country" name="country" type="text" autocomplete="country-name" required maxlength="120" aria-describedby="catalog-country-error" /><p class="form-error" id="catalog-country-error" data-field-error="country" role="alert"></p></div><div class="form-field"><label for="catalog-buyer">Buyer type</label><select id="catalog-buyer" name="buyer_type" required aria-describedby="catalog-buyer-error"><option value="" selected disabled>Select</option><option>Retailer</option><option>Importer</option><option>Distributor</option><option>Design professional</option><option>Commercial project buyer</option></select><p class="form-error" id="catalog-buyer-error" data-field-error="buyer_type" role="alert"></p></div><div class="form-field"><label for="catalog-interest">Product interest</label><select id="catalog-interest" name="product_interest" required aria-describedby="catalog-interest-error"><option value="" selected disabled>Select</option>{content.categories.map((category) => <option>{category.name}</option>)}</select><p class="form-error" id="catalog-interest-error" data-field-error="interests" role="alert"></p></div><div class="form-field form-field-wide"><label for="catalog-message">Tell us what you are sourcing</label><textarea id="catalog-message" name="message" rows="2" maxlength="2000" aria-describedby="catalog-message-error"></textarea><p class="form-error" id="catalog-message-error" data-field-error="message" role="alert"></p></div><div class="visually-hidden" aria-hidden="true"><label for="catalog-website">Website</label><input id="catalog-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div><div class="form-submit"><button class="button button-primary" type="submit">Request catalog</button><p class="form-feedback" role="status" aria-live="polite"></p></div></form></div><figure class="trade-visual"><ResponsiveImage image={{ src: "/assets/hero-tree.png", alt: "Large artificial botanical installation in a refined commercial interior" }} fallbackWidth={820} fallbackHeight={941} widths={[480, 820]} sizes="(max-width: 639px) 100vw, 50vw" loading="lazy" /></figure></section>
  <Reveal />
</PublicLayout>
