---
import Reveal from "../components/public/Reveal.astro";
import PublicLayout from "../layouts/PublicLayout.astro";
import { loadHomeContent } from "../features/public/home";

const content = await loadHomeContent(Astro.locals.runtime?.env?.DB);
const [heroFirst, heroSecond = ""] = (content.hero?.title ?? "").split(",");
const collectionDescriptions = ["Single stems & arrangements", "Flowering & foliage branches", "Potted botanical forms", "Floor-standing statement trees", "Custom commercial displays"];
---

<PublicLayout title={content.seo.title} description={content.seo.description} socialImage={content.hero?.image?.src} theme="transparent" companyName={content.settings.companyName} tagline={content.settings.tagline} social={content.settings}>
  {content.hero && <section class="hero" id="hero">
    <div class="hero-copy" data-reveal><p class="eyebrow">{content.hero.eyebrow}</p><h1>{heroFirst},<br />{heroSecond.trim()}</h1><p class="hero-intro">Wholesale artificial flowers, plants and trees for retailers, importers and distributors worldwide.</p><div class="actions"><a class="button button-primary" href="/wholesale#catalog-form">Request catalog</a><a class="button button-secondary" href="/collections">Explore wholesale collections</a></div></div>
    {content.hero.image && <figure class="hero-visual"><img src={content.hero.image.src} alt={content.hero.image.alt} width="1536" height="1536" fetchpriority="high" /></figure>}
    <span class="wholesale-mark">Trade & Wholesale</span>
  </section>}

  <section class="statement section" id="statement" data-reveal><p class="eyebrow">Our approach</p><p class="statement-copy">We create botanical forms<br />that bring the quiet presence<br />of nature into contemporary spaces.</p><div class="principles"><span>Designed for wholesale</span><span>Crafted by hand</span><span>Made to last</span></div><div class="business-line"><span><b>Wholesale collections</b><small>Curated ranges for retail, import and distribution.</small></span><span><b>Private label</b><small>Your brand, packaging and market requirements.</small></span><span><b>Sampling & Development</b><small>Materials, colors and forms developed to specification.</small></span><span><b>Export & Project Supply</b><small>Coordinated supply for global buyers and commercial projects.</small></span></div></section>

  <section class="collections section" id="collections"><header class="section-heading" data-reveal><div><p class="eyebrow">Our collections</p><h2>Botanical<br />forms.</h2></div><p>Objects with a natural rhythm, composed for spaces that value permanence over seasonality.</p></header><div class="collection-grid">{content.categories.slice(0, 5).map((category, index) => <a class:list={["collection-card", index === 0 && "collection-card-tall", index === 1 && "collection-card-wide", index === 4 && "collection-card-installation"]} href={`/collections/${category.slug}`} data-reveal>{category.image && <img src={category.image.src} alt={category.image.alt} width="1200" height="1400" loading="lazy" />}<span><b>{category.name}</b><i>{collectionDescriptions[index] ?? category.description}</i></span></a>)}</div><a class="text-link" href="/wholesale#catalog-form">Request catalog</a></section>

  {content.space && <section class="spaces section" id="spaces"><header class="section-heading light" data-reveal><div><h2>Botanicals,<br />in context.</h2></div><p>Custom botanical installations developed for commercial interiors and branded environments.</p></header><div class="spaces-tabs" aria-label="Space categories"><span class="active">Hospitality</span><span>Retail</span><span>Workplace</span><span>Events</span><span>Public spaces</span></div><a href={`/spaces/${content.space.slug}`}>{content.space.image && <figure class="spaces-visual" data-reveal><img src={content.space.image.src} alt={content.space.image.alt} width="1600" height="1067" loading="lazy" /><figcaption><span>{content.space.category}</span><span>{content.space.summary}</span></figcaption></figure>}</a></section>}

  <section class="detail section" id="detail"><figure class="detail-visual" data-reveal><img src="/assets/everstem-detail-v2.jpg" alt="Macro view of textile petals, molded leaf veins and a wrapped stem" width="1200" height="1600" loading="lazy" /></figure><div class="detail-copy" data-reveal><p class="eyebrow">The detail</p><h2>The detail<br />matters.</h2><p>From the texture of a leaf to the structure of a stem, every detail is considered.</p><ul><li><span>Textile</span>Layered petals for natural depth</li><li><span>Molded</span>Leaf veins shaped from botanical references</li><li><span>Wired</span>Flexible stems for controlled styling</li><li><span>Finished</span>Subtle tonal variation by hand</li></ul></div></section>

  <section class="journal section" id="journal"><header class="section-heading" data-reveal><div><p class="eyebrow">Botanical stories</p><h2>Notes on nature,<br />material & form.</h2></div><a class="text-link" href="/journal">View journal <span aria-hidden="true">→</span></a></header><div class="journal-grid">{content.articles.map((article, index) => <article class:list={["story", index === 0 && "story-featured"]} data-reveal><a href={`/journal/${article.slug}`}>{article.image && <img src={article.image.src} alt={article.image.alt} width="1000" height="1250" loading="lazy" />}<p class="meta">{article.category} · {article.readTime}</p><h3>{article.title}</h3></a></article>)}</div></section>

  <section class="craft section" id="craft"><div class="craft-intro" data-reveal><p class="eyebrow">Crafted with intention</p><h2>Crafted in China.<br />Designed for the world.</h2><p>From concept and sampling to production and packaging, we support brands, retailers and interior projects worldwide.</p><a class="text-link light-link" href="/wholesale#catalog-form">Request catalog</a></div><div class="capabilities" data-reveal><span>Material development</span><span>Color matching</span><span>Hand assembly</span><span>Private label</span><span>Export packaging</span><span>Quality control</span></div><figure class="craft-visual" data-reveal><img src="/assets/craft-process.png" alt="Hands, materials, molds and quality inspection in the EVERSTEM craft process" width="1800" height="900" loading="lazy" /></figure></section>

  <section class="trade section" id="trade"><div class="trade-copy" data-reveal><p class="eyebrow">For trade</p><h2>Partner with<br />EVERSTEM.</h2><p>Source artificial flowers and botanicals for wholesale collections, private label and commercial projects.</p><div class="trade-services"><span>Wholesale collections</span><span>Private label</span><span>Sampling & development</span><span>Export & project supply</span></div><form class="catalog-form" id="catalog-form" action="/api/inquiries" method="post" aria-label="Partner with EVERSTEM" data-inquiry-form data-inquiry-type="catalog" data-source-route="/"><div class="form-field"><label for="catalog-name">Name</label><input id="catalog-name" name="name" type="text" autocomplete="name" required aria-describedby="catalog-name-error" /><p class="form-error" id="catalog-name-error" data-field-error="name"></p></div><div class="form-field"><label for="catalog-company">Company</label><input id="catalog-company" name="company" type="text" autocomplete="organization" required aria-describedby="catalog-company-error" /><p class="form-error" id="catalog-company-error" data-field-error="company"></p></div><div class="form-field"><label for="catalog-email">Business email</label><input id="catalog-email" name="email" type="email" autocomplete="email" required aria-describedby="catalog-email-error" /><p class="form-error" id="catalog-email-error" data-field-error="email"></p></div><div class="form-field"><label for="catalog-country">Country / market</label><input id="catalog-country" name="country" type="text" autocomplete="country-name" required aria-describedby="catalog-country-error" /><p class="form-error" id="catalog-country-error" data-field-error="country"></p></div><div class="form-field"><label for="catalog-buyer">Buyer type</label><select id="catalog-buyer" name="buyer_type" required aria-describedby="catalog-buyer-error"><option value="" selected disabled>Select</option><option>Retailer</option><option>Importer</option><option>Distributor</option><option>Design professional</option><option>Commercial project buyer</option></select><p class="form-error" id="catalog-buyer-error" data-field-error="buyer_type"></p></div><div class="form-field"><label for="catalog-interest">Product interest</label><select id="catalog-interest" name="product_interest" required aria-describedby="catalog-interest-error"><option value="" selected disabled>Select</option>{content.categories.map((category) => <option>{category.name}</option>)}</select><p class="form-error" id="catalog-interest-error" data-field-error="interests"></p></div><div class="form-field form-field-wide"><label for="catalog-message">Tell us what you are sourcing</label><textarea id="catalog-message" name="message" rows="2"></textarea></div><div class="visually-hidden" aria-hidden="true"><label for="catalog-website">Website</label><input id="catalog-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div><div class="form-submit"><button class="button button-primary" type="submit">Request catalog</button><p class="form-feedback" role="status" aria-live="polite"></p></div></form></div><figure class="trade-visual"><img src="/assets/hero-tree.png" alt="Large artificial botanical installation in a refined commercial interior" width="1200" height="1600" loading="lazy" /></figure></section>
  <Reveal />
</PublicLayout>
